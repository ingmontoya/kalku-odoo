<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kalku_sync_log_view_list" model="ir.ui.view">
        <field name="name">kalku.sync.log.list</field>
        <field name="model">kalku.sync.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="started_at"/>
                <field name="finished_at" optional="show"/>
                <field name="sync_type"/>
                <field name="dataset"/>
                <field name="state"/>
                <field name="documents_read" optional="show"/>
                <field name="rows_sent" optional="show"/>
                <field name="skipped_no_default_code" optional="show"/>
                <field name="skipped_service" optional="hide"/>
                <field name="skipped_no_warehouse_code" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="kalku_sync_log_view_form" model="ir.ui.view">
        <field name="name">kalku.sync.log.form</field>
        <field name="model">kalku.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="sync_type"/>
                            <field name="dataset"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="documents_read"/>
                            <field name="rows_sent"/>
                            <field name="skipped_no_default_code"/>
                            <field name="skipped_service"/>
                            <field name="skipped_no_warehouse_code"/>
                        </group>
                    </group>
                    <group>
                        <field name="kalku_response"/>
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kalku_sync_log_action" model="ir.actions.act_window">
        <field name="name">Sync log</field>
        <field name="res_model">kalku.sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_kalku_root"
              name="Kalku"
              parent="stock.menu_stock_config_settings"
              groups="stock.group_stock_manager"
              sequence="90"/>
    <menuitem id="menu_kalku_sync_log"
              name="Sync log"
              parent="menu_kalku_root"
              action="kalku_sync_log_action"
              groups="stock.group_stock_manager"
              sequence="10"/>
</odoo>
